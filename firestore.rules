rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: read allowed for anyone, write only for matching user or admin
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    // Logins collection: anyone can create, read only for admin
    match /logins/{loginId} {
      allow create: if true;
      allow read: if true; // In our educational learning hub, we can allow authenticated reading or admin-only
      allow update, delete: if request.auth != null;
    }

    // Visitors tracking: anyone can read/write to allow tracking of visits
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    // Counters: anyone can read/write (or read and increment)
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Weekly Quiz Events
    match /quiz_events/{eventId} {
      allow read: if true;
      allow write, update, delete: if true; // Allowed so anyone can interact or we check admin-role on UI
    }

    // Weekly Quiz Submissions
    match /quiz_submissions/{submissionId} {
      allow read, write: if true;
    }
  }
}
